@startuml
title From source code to a deployable ASP.NET Core application

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam ArrowColor #374151
skinparam rectangle {
  BorderColor #374151
  FontColor #111827
  RoundCorner 8
}

rectangle "Inputs" {
  rectangle ".slnx and .csproj" as Projects #E0E7FF
  rectangle "Directory.Build.props\nDirectory.Packages.props" as Shared #E0E7FF
  rectangle "C# source and\nconfiguration files" as Source #E0E7FF
  rectangle "NuGet feeds" as Feed #E0E7FF
}

rectangle "dotnet restore" as Restore #FEF3C7
rectangle "obj/\nproject.assets.json\nand generated build state" as Obj #FEF3C7
rectangle "dotnet build -c Release" as Build #DCFCE7
rectangle "bin/Release/net10.0/\nassemblies, deps and runtime config" as Bin #DCFCE7
rectangle "dotnet test -c Release\n--no-build" as Test #FCE7F3
rectangle "dotnet publish -c Release\n--no-build -o artifacts/publish" as Publish #DBEAFE
rectangle "Publish directory\napplication + dependencies + content" as PublishDir #DBEAFE
rectangle "Runtime target" as Runtime #EDE9FE

Projects --> Restore
Shared --> Restore
Feed --> Restore : package metadata\nand package files
Restore --> Obj

Projects --> Build
Shared --> Build
Source --> Build
Obj --> Build : resolved dependency graph
Build --> Bin

Bin --> Test : test assemblies
Bin --> Publish
Source --> Publish : appsettings and\nweb content
Publish --> PublishDir
PublishDir --> Runtime : dotnet TradingRisk.Api.dll\nor container image

note bottom of Restore
  build, test, run, and publish can restore implicitly.
  CI commonly restores once, then uses --no-restore/--no-build.
end note
@enduml
