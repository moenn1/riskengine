@startuml
title Application startup: Spring Boot and ASP.NET Core

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam ArrowColor #374151
skinparam rectangle {
  BorderColor #374151
  FontColor #111827
  RoundCorner 8
}

rectangle "Java / Spring Boot" as Spring {
  rectangle "JVM starts\nmain(String[] args)" as JMain #FEE2E2
  rectangle "SpringApplication.run(...)" as JRun #FEE2E2
  rectangle "Create ApplicationContext\nand Environment" as JContext #FEE2E2
  rectangle "Scan configuration,\ncomponents and auto-config" as JRegister #FEE2E2
  rectangle "Instantiate beans\nand start embedded server" as JBuild #FEE2E2
  rectangle "Accept requests" as JListen #FEE2E2

  JMain --> JRun
  JRun --> JContext
  JContext --> JRegister
  JRegister --> JBuild
  JBuild --> JListen
}

rectangle "C# / ASP.NET Core" as DotNet {
  rectangle "Generated Main executes\ntop-level Program.cs" as DMain #DBEAFE
  rectangle "WebApplication\n.CreateBuilder(args)" as DBuilder #DBEAFE
  rectangle "Create host,\nconfiguration and logging" as DHost #DBEAFE
  rectangle "Explicitly register services\nin builder.Services" as DRegister #DBEAFE
  rectangle "builder.Build()\ncreates service provider" as DBuild #DBEAFE
  rectangle "Configure middleware\nand mapped endpoints" as DPipeline #DBEAFE
  rectangle "app.Run()\nstarts Kestrel" as DListen #DBEAFE

  DMain --> DBuilder
  DBuilder --> DHost
  DHost --> DRegister
  DRegister --> DBuild
  DBuild --> DPipeline
  DPipeline --> DListen
}

JMain .. DMain : entry point
JContext .. DHost : host and configuration
JRegister .. DRegister : dependency registration
JBuild .. DBuild : construct container
JListen .. DListen : HTTP server
@enduml
