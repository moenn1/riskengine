@startuml
title Dependency-injection lifetimes across HTTP requests

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName SansSerif
skinparam ArrowColor #374151
skinparam rectangle {
  BorderColor #374151
  FontColor #111827
  RoundCorner 8
}

rectangle "Root service provider\ncreated by builder.Build()" as Root #E0E7FF

rectangle "Singletons: one instance for the process" as Singletons #FEF3C7 {
  rectangle "IPortfolioRepository\n→ InMemoryPortfolioRepository" as Repository
  rectangle "IRiskCalculator\n→ HistoricalSimulationRiskCalculator" as Calculator
  rectangle "TimeProvider.System" as Clock
}

rectangle "Request A scope" as ScopeA #DBEAFE {
  rectangle "PortfoliosController A" as ControllerA
  rectangle "CalculatePortfolioRiskHandler A\n(scoped)" as HandlerA
}

rectangle "Request B scope" as ScopeB #DCFCE7 {
  rectangle "PortfoliosController B" as ControllerB
  rectangle "CalculatePortfolioRiskHandler B\n(scoped)" as HandlerB
}

Root --> Singletons : creates once, disposes at shutdown
Root --> ScopeA : creates scope
Root --> ScopeB : creates scope

ControllerA --> HandlerA
ControllerB --> HandlerB
HandlerA --> Repository : shared instance
HandlerB --> Repository : same shared instance
HandlerA --> Calculator : shared stateless instance
HandlerB --> Calculator : same shared instance
HandlerA --> Clock : shared abstraction
HandlerB --> Clock : same shared abstraction

legend bottom
  Transient services, if registered, are created each time they are resolved.
  A singleton must not capture a scoped service because the scoped object
  could then outlive the request that owns it.
endlegend
@enduml
