<Project Sdk="Microsoft.NET.Sdk.Web">
    <ItemGroup>
        <!-- Package versions come from Directory.Packages.props. -->
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
        <!-- dotnet-ef loads the startup project to discover hosting configuration. -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- Explicitly pins a patched 2.x line instead of the vulnerable transitive 2.0.0. -->
        <PackageReference Include="Microsoft.OpenApi" />
        <PackageReference Include="Swashbuckle.AspNetCore" />
    </ItemGroup>
    <ItemGroup>
        <!-- API is the composition root, so it sees ports, domain policy, and adapters. -->
        <ProjectReference Include="../TradingRisk.Application/TradingRisk.Application.csproj" />
        <ProjectReference Include="../TradingRisk.Domain/TradingRisk.Domain.csproj" />
        <ProjectReference Include="../TradingRisk.Infrastructure/TradingRisk.Infrastructure.csproj" />
    </ItemGroup>
</Project>
