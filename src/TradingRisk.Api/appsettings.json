{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "RiskDatabase": "Data Source=App_Data/riskengine.db;Foreign Keys=True;Default Timeout=5;Pooling=True"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "RiskApi": {
    "DefaultConfidenceLevel": 0.99,
    "MaxScenarioCount": 1000
  },
  "Security": {
    "Issuer": "riskengine-learning",
    "Audience": "riskengine-api",
    "DemoSigningKey": "development-only-change-me-32-bytes-long"
  }
}
